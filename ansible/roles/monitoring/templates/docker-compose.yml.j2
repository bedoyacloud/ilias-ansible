# {{ ansible_managed }}
# Los dos servicios usan la red del servidor y escuchan SOLO en 127.0.0.1. Si hay dominio, nginx hace de proxy.
services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_retention }}
      - --web.listen-address=127.0.0.1:9090
    volumes:
      - {{ monitoring_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    network_mode: host
    env_file: .env
    environment:
      GF_SERVER_HTTP_ADDR: 127.0.0.1
      GF_SERVER_HTTP_PORT: "3000"
      GF_SECURITY_ADMIN_USER: {{ monitoring_grafana_admin_user }}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
{% if monitoring_domain | length > 0 %}
      GF_SERVER_DOMAIN: {{ monitoring_domain }}
      GF_SERVER_ROOT_URL: https://{{ monitoring_domain }}/
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_SECURITY_COOKIE_SAMESITE: lax
{% endif %}
    volumes:
      - grafana-data:/var/lib/grafana
      - {{ monitoring_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro

volumes:
  prometheus-data:
  grafana-data:
